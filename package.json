{
  "name": "ifloom",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "site",
    "games/*"
  ],
  "scripts": {
    "build": "vp run build:all",
    "pack": "node scripts/pack.ts",
    "new": "ifloom new",
    "test": "vp run test:all",
    "typecheck": "vp run typecheck:all",
    "lint": "oxlint",
    "docs:dev": "npm run dev -w @ifloom/site",
    "docs:build": "npm run docs:links && npm run build -w @ifloom/site",
    "docs:links": "npm run links -w @ifloom/site"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "github-slugger": "^2.0.0",
    "jsdom": "^30.1.1",
    "oxlint": "^1.75.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "0.23.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vite-plus": "1.0.0",
    "vitest": "5.0.1"
  }
}

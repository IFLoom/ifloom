{
  "name": "@ifloom/cli",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "The IFLoom command line: dev, build a game into one HTML file, and check it.",
  "type": "module",
  "bin": {
    "ifloom": "./bin.js"
  },
  "exports": {
    ".": {
      "ifloom-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./game": {
      "ifloom-source": "./src/game.ts",
      "types": "./dist/game.d.ts",
      "import": "./dist/game.js",
      "default": "./dist/game.js"
    },
    "./vite": {
      "ifloom-source": "./src/vite.ts",
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./client": {
      "types": "./src/client.d.ts"
    }
  },
  "imports": {
    "#bin": {
      "ifloom-source": "./src/bin.ts",
      "default": "./dist/bin.js"
    }
  },
  "files": [
    "bin.js",
    "dist",
    "src",
    "templates"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "peerDependencies": {
    "@ifloom/engine": "^0.0.0"
  },
  "dependencies": {
    "vite": "^8.2.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}

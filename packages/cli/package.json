{
  "name": "@ifloom/cli",
  "version": "0.1.1",
  "license": "MIT",
  "description": "The IFLoom command line: dev, build a game into one HTML file, and check it.",
  "keywords": [
    "ifloom",
    "interactive-fiction",
    "cli",
    "vite",
    "build"
  ],
  "homepage": "https://ifloom.dev/docs/reference/cli",
  "bugs": {
    "url": "https://github.com/IFLoom/ifloom/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IFLoom/ifloom.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "ifloom": "bin.js"
  },
  "exports": {
    ".": {
      "ifloom-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./game": {
      "ifloom-source": "./src/game.ts",
      "types": "./dist/game.d.ts",
      "import": "./dist/game.js",
      "default": "./dist/game.js"
    },
    "./vite": {
      "ifloom-source": "./src/vite.ts",
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./client": {
      "types": "./src/client.d.ts"
    }
  },
  "imports": {
    "#bin": {
      "ifloom-source": "./src/bin.ts",
      "default": "./dist/bin.js"
    }
  },
  "files": [
    "bin.js",
    "dist",
    "src",
    "templates"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@ifloom/engine": "^0.1.1"
  },
  "dependencies": {
    "vite": "^8.2.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}

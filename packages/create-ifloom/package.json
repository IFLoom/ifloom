{
  "name": "create-ifloom",
  "version": "0.1.1",
  "license": "MIT",
  "description": "Start a new IFLoom game: npm create ifloom@latest my-game.",
  "keywords": [
    "ifloom",
    "interactive-fiction",
    "create",
    "scaffold",
    "template"
  ],
  "homepage": "https://ifloom.dev/docs/how-to/create-a-game",
  "bugs": {
    "url": "https://github.com/IFLoom/ifloom/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IFLoom/ifloom.git",
    "directory": "packages/create-ifloom"
  },
  "type": "module",
  "bin": {
    "create-ifloom": "bin.js"
  },
  "imports": {
    "#bin": {
      "ifloom-source": "./src/bin.ts",
      "default": "./dist/bin.js"
    }
  },
  "files": [
    "bin.js",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@ifloom/cli": "^0.1.1"
  }
}

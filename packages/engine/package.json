{
  "name": "@ifloom/engine",
  "version": "0.0.0",
  "license": "MIT",
  "description": "The IFLoom engine: state, commands, scenes, conditions and effects. No DOM, no genre.",
  "keywords": [
    "ifloom",
    "interactive-fiction",
    "game-engine",
    "text-adventure",
    "visual-novel"
  ],
  "homepage": "https://ifloom.dev/docs/reference",
  "bugs": {
    "url": "https://github.com/IFLoom/ifloom/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IFLoom/ifloom.git",
    "directory": "packages/engine"
  },
  "type": "module",
  "exports": {
    ".": {
      "ifloom-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "ifloom-source": "./src/plugin-api.ts",
      "types": "./dist/plugin-api.d.ts",
      "import": "./dist/plugin-api.js",
      "default": "./dist/plugin-api.js"
    },
    "./testing": {
      "ifloom-source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

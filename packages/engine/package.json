{
  "name": "@ifloom/engine",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "The IFLoom engine: state, commands, scenes, conditions and effects. No DOM, no genre.",
  "type": "module",
  "exports": {
    ".": {
      "ifloom-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "ifloom-source": "./src/plugin-api.ts",
      "types": "./dist/plugin-api.d.ts",
      "import": "./dist/plugin-api.js",
      "default": "./dist/plugin-api.js"
    },
    "./testing": {
      "ifloom-source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown"
  }
}

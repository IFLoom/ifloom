{
  "name": "@ifloom/plugin-calendar",
  "version": "0.2.0",
  "license": "MIT",
  "description": "A calendar for IFLoom: the periods of a day, the days of a week, sleep and a curfew, and what a turn is.",
  "keywords": [
    "ifloom",
    "interactive-fiction",
    "plugin",
    "calendar"
  ],
  "homepage": "https://ifloom.dev/docs/reference/plugins/calendar",
  "bugs": {
    "url": "https://github.com/IFLoom/ifloom/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IFLoom/ifloom.git",
    "directory": "packages/plugin-calendar"
  },
  "type": "module",
  "exports": {
    ".": {
      "ifloom-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "ifloom-source": "./src/react/index.tsx",
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@ifloom/engine": "^0.2.0",
    "@ifloom/react": "^0.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@ifloom/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ifloom/react": "^0.2.0",
    "@types/react": "^19.3.0"
  }
}

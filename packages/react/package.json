{
  "name": "@ifloom/react",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "The React UI for IFLoom games: components that draw the view, for authors to use, restyle and extend. Other frameworks use the engine directly.",
  "type": "module",
  "exports": {
    ".": {
      "ifloom-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./styles.min.css": "./dist/styles.min.css",
    "./theme.css": "./src/theme.css",
    "./themes/*.min.css": "./dist/themes/*.min.css",
    "./themes/*": "./src/themes/*"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "peerDependencies": {
    "@ifloom/engine": "^0.0.0",
    "@ifloom/audio": "^0.0.0",
    "@ifloom/browser": "^0.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.50.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@ifloom/audio": "^0.0.0",
    "@ifloom/browser": "^0.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
